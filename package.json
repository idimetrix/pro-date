{
  "name": "pro-date",
  "version": "1.0.3",
  "description": "A lightweight date utility class for parsing, formatting, and manipulating dates.",
  "license": "MIT",
  "author": {
    "name": "Dmitrii Selikhov",
    "email": "dmitrii.selikhov@gmail.com",
    "url": "https://www.linkedin.com/in/dimetrix"
  },
  "contributors": [
    {
      "name": "Dmitrii Selikhov",
      "email": "dmitrii.selikhov@gmail.com",
      "url": "https://www.linkedin.com/in/dimetrix"
    }
  ],
  "email": "dmitrii.selikhov@gmail.com",
  "scripts": {
    "build": "tsup ./src",
    "watch": "tsup ./src --watch",
    "run": "node dist/index.js",
    "dev": "pnpm run watch & nodemon dist/index.js",
    "prettier": "prettier --write src/** package.json README.md",
    "format": "pnpm run prettier && pnpm type",
    "bootstrap": "pnpm install && pnpm format",
    "type": "tsc --noEmit --incremental",
    "tsc:clean": "tsc --build --clean",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc --entryPoints ./src/index.ts --out docs --plugin typedoc-plugin-markdown"
  },
  "homepage": "https://github.com/idimetrix/pro-date#readme",
  "url": "https://github.com/idimetrix/pro-date/issue",
  "bugs": {
    "url": "https://github.com/idimetrix/pro-date/issues"
  },
  "keywords": [
    "date",
    "time",
    "datetime",
    "date-formatting",
    "date-parser",
    "date-manipulation",
    "date-utility",
    "timestamp",
    "timezone",
    "calendar",
    "date-math",
    "date-difference",
    "date-comparison",
    "business-days",
    "iso8601",
    "unix-timestamp",
    "date-library",
    "time-formatting",
    "relative-time",
    "humanize-date",
    "date-helper",
    "typescript",
    "javascript"
  ],
  "files": [
    "dist",
    "docs",
    "package.json",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "react": "19.2.0",
    "typedoc": "0.28.14",
    "typedoc-plugin-markdown": "4.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "3.0.5",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "nodemon": "3.1.10",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.0.5"
  }
}
